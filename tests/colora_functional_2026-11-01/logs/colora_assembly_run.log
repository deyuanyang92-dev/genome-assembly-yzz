        hifiasm results/reads/hifi/hifi.fastq.gz -t 4 -o results/hifiasm/asm --h1 results/fastp/hic_trim_1.fastq.gz --h2 results/fastp/hic_trim_2.fastq.gz -f 0 --ul test_data/raw_ont/ont_test_SPSC01_SRR27947616_PRJNA1075684.fastq.gz >> logs/hifiasm.log 2>&1
        mv results/hifiasm/asm.hic.hap1.p_ctg.gfa results/hifiasm/asm.hap1.gfa
