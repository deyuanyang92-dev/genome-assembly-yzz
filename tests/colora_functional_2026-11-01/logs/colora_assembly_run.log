        awk -f scripts/gfa_to_fasta.awk < results/hifiasm/asm.hap1.gfa > results/hifiasm/asm.hap1.fa
        awk -f scripts/gfa_to_fasta.awk < results/hifiasm/asm.hap2.gfa > results/hifiasm/asm.hap2.fa

